generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id        String   @id @default(uuid())
  code      String   @unique // O código de 6 dígitos (ex: 676767)
  email     String   @unique // O email gerado no mail.tm
  password  String   // A senha gerada no mail.tm
  createdAt DateTime @default(now())
}
